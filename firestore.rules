rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function firmado() { return request.auth != null; }
    function esDueno(uid) { return firmado() && request.auth.uid == uid; }
    // Asistente: alguien a quien el dueño agregó en users/{dueño}/miembros con rol "asistente"
    function esAsistente(uid) {
      return firmado()
        && exists(/databases/$(database)/documents/users/$(uid)/miembros/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(uid)/miembros/$(request.auth.uid)).data.rol == 'asistente';
    }
    // "Ocultar datos contables": ese usuario no ve ni cambia montos.
    function veDinero(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/miembros/$(request.auth.uid)).data.get('ocultarDinero', false) != true;
    }

    match /users/{uid} {
      // El dueño lee y escribe todo su libro.
      allow read, write: if esDueno(uid);
      match /{document=**} {
        allow read, write: if esDueno(uid);
      }
      // El asistente solo trabaja en Casos y su Agenda...
      match /casos/{id} {
        allow read, delete: if esAsistente(uid);
        allow create: if esAsistente(uid) && (veDinero(uid)
          || (request.resource.data.get('total', 0) == 0 && !request.resource.data.keys().hasAny(['ajuste', 'parte'])));
        allow update: if esAsistente(uid) && (veDinero(uid)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total', 'totales', 'ajuste', 'pagadosExtra', 'parte']));
      }
      // Biblioteca: el asistente ve todo, sube documentos y borra solo los suyos.
      match /biblioteca/{id} {
        allow read: if esAsistente(uid);
        allow create: if esAsistente(uid) && request.resource.data.por == request.auth.uid;
        allow delete: if esAsistente(uid) && resource.data.por == request.auth.uid;
      }
      match /audiencias/{id} {
        allow read, write: if esAsistente(uid);
      }
      // ...y solo ve o registra pagos que pertenecen a un caso (nunca tus otros movimientos).
      // Notas: el usuario ve las notas para él y las que él escribió; solo puede escribirle al dueño.
      match /notas/{id} {
        allow read: if esAsistente(uid) && (resource.data.para == request.auth.uid || resource.data.autor == request.auth.uid);
        allow create: if esAsistente(uid) && request.resource.data.autor == request.auth.uid && request.resource.data.para == 'dueno';
        allow update: if esAsistente(uid) && (
          (resource.data.autor == request.auth.uid && request.resource.data.autor == request.auth.uid && request.resource.data.para == resource.data.para)
          || (resource.data.para == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas'])));
        allow delete: if esAsistente(uid) && resource.data.autor == request.auth.uid;
      }
      match /movimientos/{id} {
        allow read, delete: if esAsistente(uid) && veDinero(uid) && resource.data.casoId > '';
        allow create: if esAsistente(uid) && veDinero(uid) && request.resource.data.casoId > ''
          && request.resource.data.tipo == 'Ingreso' && request.resource.data.categoria == 'Honorarios por casos';
      }
    }

    // Aviso para que cada usuario sepa a qué libro entra. No da permisos por sí solo.
    match /accesos/{guest} {
      allow read: if firmado() && (request.auth.uid == guest || resource.data.owner == request.auth.uid);
      allow create: if firmado() && request.resource.data.owner == request.auth.uid;
      allow update: if firmado() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if firmado() && resource.data.owner == request.auth.uid;
    }
  }
}
